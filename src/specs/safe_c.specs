# Safe-C toolchain specs for GCC / G++
# Loads safe_c automatically unless disabled globally or per invocation.
#
# Global/per-TU toggles:
#   -DSAFE_C_DISABLE          Disable plugin for this invocation
#   -DSAFE_C_ENABLE           Force-enable plugin (overrides -DSAFE_C_DISABLE / SAFE_C_DISABLE)
#   -DSAFE_C_WARN_ONLY        Emit warnings instead of halting compilation
#   -DSAFE_C_FATAL            Halt compilation on violations (default)
#   -DSAFE_C_NO_LEAKS         Disable heap leak checks
#   -DSAFE_C_NO_DOUBLE_FREE   Disable double-free checks
#   -DSAFE_C_NO_UAF           Disable use-after-free checks
#   -DSAFE_C_NO_BOUNDS        Disable static spatial bounds checks
#   -DSAFE_C_NO_NULL          Disable null pointer dereference checks
#   -DSAFE_C_NO_ARITHMETIC    Disable pointer-arithmetic base-retention checks
#   -DSAFE_C_NO_ITERATOR      Disable C++ container iterator invalidation checks

*self_spec:
+ %{!fplugin-arg-safe_c-disable:%{!fplugin-arg-safe_cpp-disable:%{DSAFE_C_ENABLE|!DSAFE_C_DISABLE:%{DSAFE_C_ENABLE|!DSAFE_CPP_DISABLE:%{!fplugin*:-fplugin=safe_c %{DSAFE_C_ENABLE:-fplugin-arg-safe_c-enable} %{DSAFE_C_WARN_ONLY:-fplugin-arg-safe_c-mode=warn} %{DSAFE_C_FATAL:-fplugin-arg-safe_c-mode=fatal} %{DSAFE_C_NO_LEAKS:-fplugin-arg-safe_c-leaks=off} %{DSAFE_C_NO_DOUBLE_FREE:-fplugin-arg-safe_c-double-free=off} %{DSAFE_C_NO_UAF:-fplugin-arg-safe_c-uaf=off} %{DSAFE_C_NO_BOUNDS:-fplugin-arg-safe_c-bounds=off} %{DSAFE_C_NO_NULL:-fplugin-arg-safe_c-null=off} %{DSAFE_C_NO_ARITHMETIC:-fplugin-arg-safe_c-arithmetic=off} %{DSAFE_C_NO_ITERATOR:-fplugin-arg-safe_c-iterator=off}}}}}}
