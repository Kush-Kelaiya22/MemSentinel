# Safe-C Toolchain Specs File for GCC / G++ (MinGW-w64 and Linux)
# Instructs GCC driver to load the Safe-C plugin for all compilations.
# To disable Safe-C: pass -DSAFE_C_DISABLE, -fplugin-arg-safe_c-disable, or set SAFE_C_DISABLE=1.

*self_spec:
+ %{!DSAFE_C_DISABLE:%{!DSAFE_CPP_DISABLE:%{!fplugin-arg-safe_c-disable:%{!fplugin-arg-safe_cpp-disable:%{!fplugin*:-fplugin=safe_c}}}}}
